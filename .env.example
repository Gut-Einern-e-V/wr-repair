# Public application URL. Use the Vercel production domain after the first deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser client. These values are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Supabase server client. Never prefix this variable with NEXT_PUBLIC_ and never commit its value.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Friendly Captcha v2. The sitekey starts with FC and is safe in the browser; the API key is server-only.
# Register every local, preview, and production hostname in the Friendly Captcha dashboard.
NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=FCMNM3R7JRA5C82C
FRIENDLY_CAPTCHA_API_KEY=replace_with_your_friendly_captcha_api_key
# Keep this true in public operation. Set to false only for a temporary configuration bypass.
NEXT_PUBLIC_CAPTCHA_ENABLED=true

# Submission window, in ISO 8601 with an explicit timezone.
SUBMISSION_START_AT=2026-10-01T00:00:00+02:00
SUBMISSION_END_AT=2026-10-31T23:59:59+01:00

# Local development only: permits submissions without Vercel's geo headers.
# Do not set this in Vercel, Preview, or Production.
GEOIP_ALLOW_LOCAL=false

# Regional restriction — defaults ship pre-configured for Nordrhein-Westfalen.
# Adapt these values to deploy the platform for a different region.
#
# Set to "false" to disable all location checks (e.g. for testing or open campaigns).
REGION_RESTRICTION_ENABLED=true
#
# Human-readable region name stored in the database and shown in the UI.
REGION_LABEL=Nordrhein-Westfalen
# Same value for the browser bundle (Next.js public env).
NEXT_PUBLIC_REGION_LABEL=Nordrhein-Westfalen
#
# ISO 3166-1 alpha-2 country code expected in the Vercel x-vercel-ip-country header.
REGION_IP_COUNTRY=DE
# Vercel sub-region code expected in x-vercel-ip-country-region.
# Leave empty to only check the country (useful for country-wide or cross-region deployments).
REGION_IP_REGION=NW
#
# Geographic bounding box for EXIF GPS fallback verification.
# Leave all four empty to disable the GPS fallback check.
REGION_GEO_LAT_MIN=50.3
REGION_GEO_LAT_MAX=52.6
REGION_GEO_LON_MIN=5.9
REGION_GEO_LON_MAX=9.5

# Comma-separated trusted origins for future server-side CORS checks.
ALLOWED_ORIGINS=http://localhost:3000
# Web-Push für Benachrichtigungen der Moderation bei neuen Einreichungen.
# Einmalig erzeugen mit: npx web-push generate-vapid-keys
# Ohne diese drei Werte bleibt der Umschalter in der Moderationskonsole
# deaktiviert und Einreichungen laufen unverändert weiter.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
# Server-only. Never prefix this variable with NEXT_PUBLIC_ and never commit its value.
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
# Contact address the push services use to report problems. mailto: or https:.
VAPID_SUBJECT=mailto:severin.hackspiel@gut-einern.org
